  <diagram id="guide-v2" name="09 - User Guide">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="PANDUAN PENGGUNA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#153D36;strokeColor=#153D36;fontColor=#FFFFFF;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1520" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="ts" value="Perjalanan utama dari registrasi hingga ekspor laporan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF4F1;strokeColor=#EAF4F1;fontColor=#153D36;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="1520" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="u1" value="&lt;b&gt;1. Registrasi / Login&lt;/b&gt;&lt;br&gt;&lt;br&gt;Buat akun dan masuk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#153D36;fontColor=#0F172A;fontSize=15;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="180" width="400" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="u2" value="&lt;b&gt;2. Lengkapi Profil&lt;/b&gt;&lt;br&gt;&lt;br&gt;Profil, avatar, password" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#153D36;fontColor=#0F172A;fontSize=15;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="570" y="180" width="400" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="u3" value="&lt;b&gt;3. Buat / Gabung Tim&lt;/b&gt;&lt;br&gt;&lt;br&gt;Undangan Gmail dan role" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#153D36;fontColor=#0F172A;fontSize=15;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1070" y="180" width="400" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="u4" value="&lt;b&gt;4. Buat Proyek&lt;/b&gt;&lt;br&gt;&lt;br&gt;Owner/Admin membuat papan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#153D36;fontColor=#0F172A;fontSize=15;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="400" width="400" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="u5" value="&lt;b&gt;5. Buat Tugas&lt;/b&gt;&lt;br&gt;&lt;br&gt;Assignee, tenggat, file" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#153D36;fontColor=#0F172A;fontSize=15;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="570" y="400" width="400" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="u6" value="&lt;b&gt;6. Berkolaborasi&lt;/b&gt;&lt;br&gt;&lt;br&gt;Checklist, komentar, chat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#153D36;fontColor=#0F172A;fontSize=15;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1070" y="400" width="400" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="u7" value="&lt;b&gt;7. Hubungkan WhatsApp&lt;/b&gt;&lt;br&gt;&lt;br&gt;Token, preferensi, quiet hours" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#153D36;fontColor=#0F172A;fontSize=15;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="620" width="400" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="u8" value="&lt;b&gt;8. Cari &amp; Pantau&lt;/b&gt;&lt;br&gt;&lt;br&gt;Search, filter, ringkasan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#153D36;fontColor=#0F172A;fontSize=15;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="570" y="620" width="400" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="u9" value="&lt;b&gt;9. Buka Laporan&lt;/b&gt;&lt;br&gt;&lt;br&gt;Workload, activity, PDF/XLSX" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#153D36;fontColor=#0F172A;fontSize=15;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
